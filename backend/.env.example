# Copiez ce fichier en ".env" (dans ce même dossier backend/) et remplissez les valeurs.
# Ce fichier .env.example peut être commité sans risque : il ne contient aucun secret.
# Le fichier .env, lui, ne doit JAMAIS être commité (il est dans .gitignore).

# --- Base de données PostgreSQL (Neon, ou toute autre base Postgres) ---
# Sur Neon (console.neon.tech) : Dashboard du projet -> "Connection string"
DB_URL=jdbc:postgresql://VOTRE-HOTE.neon.tech/VOTRE_BASE?sslmode=require&channel_binding=require
DB_USERNAME=votre_utilisateur
DB_PASSWORD=votre_mot_de_passe

# --- IA (Google Gemini - gratuit, sans carte bancaire) ---
# Clé API : https://aistudio.google.com/apikey
GEMINI_API_KEY=votre_cle_gemini

# --- Les variables ci-dessous ont des valeurs par défaut correctes pour le développement local ---
# et n'ont PAS besoin d'être modifiées, sauf cas particulier :

# SERVER_PORT=8081
# CORS_ALLOWED_ORIGINS=http://localhost:5173
# JWT_SECRET=... (une valeur par défaut est déjà définie pour le dev local)
# ADMIN_SEED_EMAIL=admin@stageia.local
# ADMIN_SEED_PASSWORD=ChangeMe123!
# UPLOAD_DIR=uploads
